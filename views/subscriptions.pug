extends ./layout.pug

block title
  | Subscriptions · Alarm & Alert Service

block content
  .page-header
    div
      h1 Subscriptions
      p.page-lead Pick the events you want alerts for. Add site tags to hear only about the sites you care about.

  .subs-layout
    section.panel.catalog(aria-labelledby='catalog-title')
      .panel-head
        h2#catalog-title Catalog
        .segmented(role='tablist' aria-label='Event source')
          button.seg(type='button' role='tab' data-source='alarms' aria-selected='true')
            | Alarms
            span.seg-count(data-count='alarms')
          button.seg(type='button' role='tab' data-source='heartbeats' aria-selected='false')
            | Heartbeats
            span.seg-count(data-count='heartbeats')
      label.search
        +icon('search')
        input#catalog-search(type='search' placeholder='Search events' autocomplete='off' aria-label='Search events')
      #catalog-tree.tree(aria-label='Events')

    section.panel.mine(aria-labelledby='mine-title')
      .panel-head
        h2#mine-title
          | Your subscriptions
          span.count-badge#subs-count
      #subs-list.subs-list
      .empty#subs-empty(hidden)
        p.empty-title No subscriptions yet
        p Tick events in the catalog to start receiving alerts.

  .savebar#savebar(hidden role='region' aria-label='Unsaved changes')
    span.savebar-text
      span.savebar-dot
      | Unsaved changes
    button.btn.btn-ghost.btn-sm#discard(type='button') Discard
    button.btn.btn-primary.btn-sm#save(type='button') Save changes

  script#page-data(type='application/json')!= json(pageData)

block append scripts
  script(src='/js/subscriptions.js' defer)
