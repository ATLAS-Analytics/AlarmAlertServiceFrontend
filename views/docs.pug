extends ./layout.pug

block title
  | Documentation · Alarm & Alert Service

block content
  .docs
    nav.docs-toc(aria-label='On this page')
      p.toc-title Contents
      ul
        each section in toc
          li
            a(href=`#${section.id}`)= section.text
            if section.children.length
              ul
                each sub in section.children
                  li: a(href=`#${sub.id}`)= sub.text

    //- rendered from docs/documentation.md by routes/docs.js
    article.docs-body!= html

block append scripts
  script(src='/js/docs.js' defer)
