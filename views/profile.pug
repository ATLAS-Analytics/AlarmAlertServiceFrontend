extends ./layout.pug

block title
  | Profile · Alarm & Alert Service

block content
  .page-header
    div
      h1 Profile
      p.page-lead Your account and how you’d like to receive alerts.

  .profile-layout
    section.panel.account
      .account-head
        - const initials = (user || email || '?').split(/\s+/).filter(Boolean).slice(0, 2).map((w) => w[0]).join('').toUpperCase()
        .avatar.avatar-lg= initials
        div
          .account-name= user
          .muted= email
      dl.kv
        div
          dt Organization
          dd= affiliation || '—'
        div
          dt Username
          dd= username || '—'
      a.btn.btn-secondary.btn-block(href='/logout')
        +icon('log-out')
        | Sign out

    section.panel
      .panel-head
        h2 Notification preferences
      form#prefs-form.prefs-form(novalidate)
        each val, key in config
          .pref-row
            if val.type === 'boolean'
              label.pref-label(for=key)= val.name
              label.switch
                input.prefs(id=key name=key type='checkbox' checked=preferences[key])
                span.switch-track(aria-hidden='true')
            else if val.type === 'number'
              label.pref-label(for=key)= val.name
              input.input.input-number.prefs(id=key name=key type='number' value=preferences[key])
            else if val.type === 'email'
              .pref-label
                label(for=key)= val.name
                span.pref-hint Leave empty to use #{email}
              input.input.prefs(id=key name=key type='email' value=preferences[key] placeholder=email)
        .form-actions
          button.btn.btn-primary#save-prefs(type='submit' disabled) Save preferences

  script#page-data(type='application/json')!= json({ userId })

block append scripts
  script(src='/js/profile.js' defer)
